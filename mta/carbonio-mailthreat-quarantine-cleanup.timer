[Unit]
Description=Carbonio Mail Threat Quarantine Cleanup Daily
Documentation=https://docs.zextras.com/
PartOf=carbonio-mta.target

[Timer]
OnCalendar=*-*-* 01:00:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=carbonio-mta.target
