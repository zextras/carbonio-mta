_package() {
  cd "${srcdir}"

  # consul for mta
  install -Dm755 "${pkgname}.sh" \
    "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "${pkgname}.hcl" \
    "${pkgdir}/etc/zextras/service-discover/${pkgname}.hcl"
  install -Dm644 "211-${pkgname}.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/211-${pkgname}.sh"
  install -Dm644 policies.json \
    "${pkgdir}/etc/carbonio/mta/service-discover/policies.json"
  install -Dm644 intentions.json \
    "${pkgdir}/etc/carbonio/mta/service-discover/intentions.json"
  install -Dm644 service-protocol.json \
    "${pkgdir}/etc/carbonio/mta/service-discover/service-protocol.json"

  # postfix
  install -Dm644 postfix_master.cf.in \
    "${pkgdir}/opt/zextras/common/conf/master.cf.in"
  install -Dm644 postfix_tag_as_foreign.re.in \
    "${pkgdir}/opt/zextras/common/conf/tag_as_foreign.re.in"
  install -Dm644 postfix_tag_as_originating.re.in \
    "${pkgdir}/opt/zextras/common/conf/tag_as_originating.re.in"

  mkdir -p "${pkgdir}/opt/zextras/data/altermime/"
  mkdir -p "${pkgdir}/opt/zextras/data/cbpolicyd/"
  mkdir -p "${pkgdir}/opt/zextras/data/cbpolicyd/db/"
  mkdir -p "${pkgdir}/opt/zextras/data/clamav/"
  mkdir -p "${pkgdir}/opt/zextras/data/opendkim/"
  mkdir -p "${pkgdir}/opt/zextras/data/postfix/"

  # systemd sysusers.d
  install -Dm644 "${srcdir}/systemd-sysuser.conf" \
    "${pkgdir}/usr/lib/sysusers.d/${pkgname}.conf"
  # systemd tmpfiles.d
  install -Dm644 "${srcdir}/systemd-tmpfile.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/${pkgname}.conf"
}

_package_systemd() {
  # systemd units and target
  install -Dm644 "${pkgname}.target" \
    "${pkgdir}/usr/lib/systemd/system/${pkgname}.target"

  install -Dm644 "${srcdir}/${pkgname}-sidecar.service" \
    "${pkgdir}/usr/lib/systemd/system/${pkgname}-sidecar.service"

  install -Dm644 "${srcdir}/carbonio-mta-queue-log.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-mta-queue-log.service"
  install -Dm644 "${srcdir}/carbonio-mta-queue-log.timer" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-mta-queue-log.timer"

  install -Dm644 "${srcdir}/carbonio-antispam-train.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-antispam-train.service"
  install -Dm644 "${srcdir}/carbonio-antispam-train.timer" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-antispam-train.timer"

  install -Dm644 "${srcdir}/carbonio-antispam-train-cleanup.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-antispam-train-cleanup.service"
  install -Dm644 "${srcdir}/carbonio-antispam-train-cleanup.timer" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-antispam-train-cleanup.timer"

  install -Dm644 "${srcdir}/carbonio-antispam-bayes-expire.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-antispam-bayes-expire.service"
  install -Dm644 "${srcdir}/carbonio-antispam-bayes-expire.timer" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-antispam-bayes-expire.timer"

  install -Dm644 "${srcdir}/carbonio-mailthreat-tmp-cleanup.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-mailthreat-tmp-cleanup.service"
  install -Dm644 "${srcdir}/carbonio-mailthreat-tmp-cleanup.timer" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-mailthreat-tmp-cleanup.timer"

  install -Dm644 "${srcdir}/carbonio-mailthreat-quarantine-cleanup.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-mailthreat-quarantine-cleanup.service"
  install -Dm644 "${srcdir}/carbonio-mailthreat-quarantine-cleanup.timer" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-mailthreat-quarantine-cleanup.timer"

  install -Dm644 "${srcdir}/carbonio-policyd-cleanup.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-policyd-cleanup.service"
  install -Dm644 "${srcdir}/carbonio-policyd-cleanup.timer" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-policyd-cleanup.timer"
}

package() {
  _package
  _package_systemd
}

package__rocky_8() {
  _package
  install -Dm644 "${srcdir}/${pkgname}-sidecar-legacy.service" \
    "${pkgdir}/usr/lib/systemd/system/${pkgname}-sidecar.service"
}

package__rocky_9() {
  _package
  _package_systemd
}

package__ubuntu_jammy() {
  _package
  install -Dm644 "${srcdir}/${pkgname}-sidecar-legacy.service" \
    "${pkgdir}/usr/lib/systemd/system/${pkgname}-sidecar.service"
}

package__ubuntu_noble() {
  _package
  _package_systemd
}

_postinst_sendmail() {
  #Symlinks
  if [ ! -e "/usr/sbin/sendmail" ] || [ -L "/usr/sbin/sendmail" ]; then
    if [ -L "/usr/sbin/sendmail" ]; then
      SMPATH=$(readlink /usr/sbin/sendmail)
      if [ "$SMPATH" = "/opt/zextras/postfix/sbin/sendmail" ] || [ "$SMPATH" = "/opt/zextras/common/sbin/sendmail" ]; then
        rm -f /usr/sbin/sendmail
        ln -s /opt/zextras/common/sbin/sendmail /usr/sbin/sendmail
      fi
    else
      ln -s /opt/zextras/common/sbin/sendmail /usr/sbin/sendmail
    fi
  fi
}

_postinst() {
  # Note: Directory creation for amavisd, clamav, postfix handled by their respective packages' tmpfiles.d

  if [ ! -e /etc/aliases ] || [ -L /etc/aliases ]; then
    if [ -L /etc/aliases ]; then
      SMPATH=$(readlink /etc/aliases)
      if [ "$SMPATH" = "/opt/zextras/postfix/conf/aliases" ] || [ "$SMPATH" = "/opt/zextras/common/conf/aliases" ]; then
        rm -f /etc/aliases
        ln -s /opt/zextras/common/conf/aliases /etc/aliases
      fi
    else
      ln -s /opt/zextras/common/conf/aliases /etc/aliases
    fi
  fi

  systemd-sysusers >/dev/null 2>&1 || :
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/carbonio-mta.conf >/dev/null 2>&1 || :

  echo "======================================================"
  echo "Carbonio mta installed successfully!"
  echo "You must run pending-setups to configure it correctly."
  echo "======================================================"
}

_postinst_legacy() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload &>/dev/null || :
    systemctl enable carbonio-mta-sidecar.service &>/dev/null || :
    systemctl enable carbonio-mta-queue-log.timer carbonio-antispam-train.timer carbonio-antispam-train-cleanup.timer carbonio-antispam-bayes-expire.timer carbonio-mailthreat-tmp-cleanup.timer carbonio-mailthreat-quarantine-cleanup.timer carbonio-policyd-cleanup.timer &>/dev/null || :
    if systemctl -q is-active carbonio-mta.target; then
      systemctl start carbonio-mta-queue-log.timer carbonio-antispam-train.timer carbonio-antispam-train-cleanup.timer carbonio-antispam-bayes-expire.timer carbonio-mailthreat-tmp-cleanup.timer carbonio-mailthreat-quarantine-cleanup.timer carbonio-policyd-cleanup.timer &>/dev/null || :
    fi
  fi
}

_postinst_systemd() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload &>/dev/null || :
    systemctl enable carbonio-mta.target &>/dev/null || :
    systemctl enable carbonio-mta-sidecar.service &>/dev/null || :
  fi
}

postinst__ubuntu_jammy() {
  _postinst_sendmail
  _postinst
  _postinst_legacy
}

postinst__ubuntu_noble() {
  _postinst_sendmail
  _postinst
  _postinst_systemd
}

postinst__rocky_8() {
  _postinst
  _postinst_legacy
}

postinst__rocky_9() {
  _postinst
  _postinst_systemd
}

_prerm_legacy() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-mta-sidecar.service &>/dev/null || :
    systemctl stop carbonio-mta-sidecar.service &>/dev/null || :
  fi
}

_prerm_systemd() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable --now carbonio-mta.target &>/dev/null || :
    systemctl --no-reload disable --now carbonio-mta-sidecar.service &>/dev/null || :
    systemctl --no-reload disable --now carbonio-mta-queue-log.timer carbonio-antispam-train.timer carbonio-antispam-train-cleanup.timer carbonio-antispam-bayes-expire.timer carbonio-mailthreat-tmp-cleanup.timer carbonio-mailthreat-quarantine-cleanup.timer carbonio-policyd-cleanup.timer &>/dev/null || :
  fi
}

prerm__apt() {
  _prerm_legacy
}

prerm__ubuntu_noble() {
  _prerm_systemd
}

prerm__rocky_8() {
  _prerm_legacy
}

prerm__rocky_9() {
  _prerm_systemd
}

postrm() {
  rm -f /etc/carbonio/mta/service-discover/token
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload &>/dev/null || :
  fi
}
