[Unit]
Description=Carbonio MTA Queue Logging Every 10 Minutes
Documentation=https://docs.zextras.com/
PartOf=carbonio-mta.target

[Timer]
OnCalendar=*:00/10
Persistent=true

[Install]
WantedBy=carbonio-mta.target
