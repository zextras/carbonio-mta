[Unit]
Description=Carbonio Mail Threat Temporary Files Cleanup
Documentation=https://docs.zextras.com/
After=carbonio-mta.target

[Service]
Type=oneshot
User=zextras
Group=zextras
# The environment the zextras login shell (.bashrc) gives the scripts
Environment=PATH=/opt/zextras/bin:/opt/zextras/common/lib/jvm/java/bin:/opt/zextras/common/bin:/opt/zextras/common/sbin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PERL5LIB="/opt/zextras/common/lib/perl5/x86_64-linux-gnu-thread-multi:/opt/zextras/common/lib/perl5/x86_64-linux-thread-multi:/opt/zextras/common/lib/perl5"
ExecStart=/usr/bin/find /opt/zextras/data/amavisd/tmp -mindepth 1 -maxdepth 1 -type d -name 'amavis-*' -mtime +1 -exec rm -rf {} +
Nice=10
IOSchedulingClass=idle
