[Unit]
Description=Carbonio Policyd Database Cleanup
Documentation=https://docs.zextras.com/
After=carbonio-mta.target
# configd writes the file only where policyd is enabled; the cleanup exits 1
# without it
ConditionPathExists=/opt/zextras/conf/gopp-policyd.cfg

[Service]
Type=oneshot
User=zextras
Group=zextras
ExecStart=/opt/zextras/common/bin/gopp -carbonio cleanup -c /opt/zextras/conf/gopp-policyd.cfg
Nice=10
IOSchedulingClass=idle
